# Server Configuration
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Temporary File Storage & Uploads
UPLOAD_MAX_MB=25
TEMP_DIR=./tmp
JOB_RETENTION_MINUTES=120

# Primary LLM Provider: "gemini" (Free tier via Google AI Studio)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
GEMINI_API_KEY=

# Fallback LLM Provider: "groq" (Free tier via Groq Cloud) or OpenAI compatible
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# LLM Execution Limits
LLM_TIMEOUT_MS=120000
LLM_MAX_RETRIES=3
LLM_MAX_CONCURRENCY=2

# Transcript Chunking Parameters
CHUNK_MAX_TOKENS=6000
CHUNK_OVERLAP_TOKENS=300
