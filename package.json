{
  "name": "ai-mom-generator",
  "version": "1.0.0",
  "private": true,
  "description": "AI Minutes of Meeting Generator MVP",
  "scripts": {
    "server:dev": "npm --prefix server run dev",
    "server:build": "npm --prefix server run build",
    "server:test": "npm --prefix server run test",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run server:dev\" \"npm run client:dev\"",
    "test": "npm run server:test",
    "test:ui": "playwright test",
    "test:prompts": "promptfoo eval",
    "test:api": "schemathesis run ./server/openapi.yaml --checks all",
    "test:triage": "node scripts/agentic-triage.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.1.2",
    "promptfoo": "^0.125.1"
  }
}
